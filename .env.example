# Configuration reference; the Rust binary does not auto-load dotenv files.
# Set these in your service environment. Never commit a real bearer secret.
ARCHER_API_TOKEN=
ARCHER_BIND=127.0.0.1:8080
ARCHER_CORS_ORIGINS=
ARCHER_GITHUB_REPOSITORIES=
ARCHER_CONCURRENCY=1
ARCHER_RETAINED_JOBS=8
ARCHER_RETENTION_SECONDS=600
ARCHER_TIMEOUT_SECONDS=90
ARCHER_MEMORY_MIB=1024
ARCHER_EVIDENCE_TEXT=redact
# Set deployment-specific absolute, trusted paths when needed:
# ARCHER_WORK_ROOT=/var/lib/archer/work
# ARCHER_CARGO_BIN=/opt/rust-toolchain/bin/cargo
# ARCHER_CURL_BIN=/usr/bin/curl
